+package com.msp1974.vacompanion.device.authentication
+
+import io.ktor.client.request.get
+import io.ktor.client.statement.bodyAsText
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.net.InetAddress
+import java.nio.file.Files
+import java.nio.file.Path
+import java.security.KeyStore
+import java.security.SecureRandom
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+import javax.net.ssl.HttpsURLConnection
+import javax.net.ssl.KeyManagerFactory
+import javax.net.ssl.SSLContext
+import javax.net.ssl.SSLException
+import javax.net.ssl.SSLServerSocket
+import javax.net.ssl.SSLSocket
+import javax.net.ssl.TrustManagerFactory
+
+/** Real JVM TLS through the production Ktor Android engine. All keys are temporary fixtures. */
+class HttpClientProviderTlsTest {
+    private class Endpoint : AutoCloseable {
+        val directory: Path = Files.createTempDirectory("vaca-tls-test-")
+        val requests = AtomicInteger()
+        val trusted: SSLContext
+        private val executor = Executors.newSingleThreadExecutor()
+        private val server: SSLServerSocket
+
+        init {
+            val store = directory.resolve("fixture.p12")
+            // Public test-only password; no operator keystore is opened or changed.
+            val log = directory.resolve("keytool.log")
+            val command = ProcessBuilder(
+                Path.of(System.getProperty("java.home"), "bin", "keytool").toString(),
+                "-genkeypair", "-keystore", store.toString(), "-storetype", "PKCS12",
+                "-storepass", "test-only", "-alias", "fixture", "-keyalg", "RSA",
+                "-keysize", "2048", "-validity", "1", "-dname", "CN=localhost",
+                "-ext", "SAN=dns:localhost"
+            ).redirectErrorStream(true).redirectOutput(log.toFile()).start()
+            if (!command.waitFor(30, TimeUnit.SECONDS)) {
+                command.destroyForcibly()
+                error("Synthetic keytool timed out")
+            }
+            check(command.exitValue() == 0) { Files.readString(log) }
+            val keys = KeyStore.getInstance("PKCS12")
+            Files.newInputStream(store).use { keys.load(it, "test-only".toCharArray()) }
+            val managers = KeyManagerFactory.getInstance(KeyManagerFactory.getDefaultAlgorithm())
+            managers.init(keys, "test-only".toCharArray())
+            val serverContext = SSLContext.getInstance("TLS")
+            serverContext.init(managers.keyManagers, null, SecureRandom())
+            val trust = KeyStore.getInstance(KeyStore.getDefaultType())
+            trust.load(null, null)
+            trust.setCertificateEntry("fixture", keys.getCertificate("fixture"))
+            val roots = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm())
+            roots.init(trust)
+            trusted = SSLContext.getInstance("TLS")
+            trusted.init(null, roots.trustManagers, SecureRandom())
+            server = serverContext.serverSocketFactory.createServerSocket(
+                0, 5, InetAddress.getByName("127.0.0.1")
+            ) as SSLServerSocket
+            executor.submit {
+                while (!server.isClosed) {
+                    try {
+                        (server.accept() as SSLSocket).use { socket ->
+                            socket.soTimeout = 3000
+                            val input = socket.inputStream.bufferedReader()
+                            val first = input.readLine()
+                            if (first != null) {
+                                requests.incrementAndGet()
+                                while (!input.readLine().isNullOrEmpty()) { /* headers */ }
+                                socket.outputStream.write(
+                                    "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok".toByteArray()
+                                )
+                                socket.outputStream.flush()
+                            }
+                        }
+                    } catch (_: java.io.IOException) { /* rejected handshake or fixture shutdown */ }
+                }
+            }
+        }
+
+        fun url(host: String = "localhost") = "https://$host:${server.localPort}/fixture"
+
+        override fun close() {
+            server.close()
+            executor.shutdownNow()
+            check(executor.awaitTermination(10, TimeUnit.SECONDS))
+            Files.walk(directory).use { paths ->
+                paths.sorted(Comparator.reverseOrder()).forEach { Files.delete(it) }
+            }
+        }
+    }
+
+    private fun get(url: String, ignore: Boolean = false): String = runBlocking {
+        HttpClientProvider { ignore }.get().use { client -> client.get(url).bodyAsText() }
+    }
+
+    private fun rejected(action: () -> Unit) {
+        val failure = runCatching(action).exceptionOrNull()
+        assertTrue("actual TLS validation must fail, not an unrelated setup error: $failure",
+            generateSequence(failure) { it.cause }.any { it is SSLException })
+    }
+
+    @Test fun untrustedCertificateFailsBeforeHttp() {
+        Endpoint().use { endpoint ->
+            rejected { get(endpoint.url()) }
+            assertEquals(0, endpoint.requests.get())
+        }
+    }
+
+    @Test fun matchingTrustedCertificateWorksAndWrongHostnameFails() {
+        Endpoint().use { endpoint ->
+            val previous = HttpsURLConnection.getDefaultSSLSocketFactory()
+            try {
+                HttpsURLConnection.setDefaultSSLSocketFactory(endpoint.trusted.socketFactory)
+                assertEquals("ok", get(endpoint.url()))
+                assertEquals(1, endpoint.requests.get())
+                rejected { get(endpoint.url("127.0.0.1")) }
+                assertEquals(1, endpoint.requests.get())
+            } finally {
+                HttpsURLConnection.setDefaultSSLSocketFactory(previous)
+            }
+        }
+    }
+
+    @Test fun explicitCompatibilityOptInIsPerClientOnly() {
+        Endpoint().use { endpoint ->
+            assertEquals("ok", get(endpoint.url("127.0.0.1"), ignore = true))
+            assertEquals(1, endpoint.requests.get())
+            rejected { get(endpoint.url()) }
+            assertEquals(1, endpoint.requests.get())
+        }
+    }
+}
