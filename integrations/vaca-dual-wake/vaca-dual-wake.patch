+package com.msp1974.vacompanion.wakeword
+
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.*
+import org.junit.Test
+
+class CloseableResourceTest {
+    private class Resource(private val failClose: Boolean = false) : AutoCloseable {
+        var closes = 0
+        override fun close() {
+            closes++
+            if (failClose) throw IllegalStateException("close failed")
+        }
+    }
+
+    @Test fun stoppingClosesTheActiveDetectorOnce() = runBlocking {
+        val slot = CloseableResource<Resource>()
+        val detector = Resource()
+        slot.replace { detector }
+        assertSame(detector, slot.value)
+        slot.close()
+        slot.close()
+        assertEquals(1, detector.closes)
+    }
+
+    @Test fun replacingClosesOldDetectorAndRetainsNewOneUntilStop() = runBlocking {
+        val slot = CloseableResource<Resource>()
+        val first = Resource()
+        val second = Resource()
+        slot.replace { first }
+        slot.replace { second }
+        assertEquals(1, first.closes)
+        assertEquals(0, second.closes)
+        slot.close()
+        assertEquals(1, second.closes)
+    }
+
+    @Test fun failedReplacementDoesNotCloseOldDetectorTwice() = runBlocking {
+        val slot = CloseableResource<Resource>()
+        val first = Resource()
+        slot.replace { first }
+        try {
+            slot.replace { throw IllegalArgumentException("model failed to load") }
+            fail("Expected loading failure")
+        } catch (_: IllegalArgumentException) { }
+        slot.close()
+        assertEquals(1, first.closes)
+    }
+
+    @Test fun failedCloseDoesNotLoadReplacementOrCloseTwice() = runBlocking {
+        val slot = CloseableResource<Resource>()
+        val first = Resource(failClose = true)
+        slot.replace { first }
+        var created = false
+        try {
+            slot.replace { created = true; Resource() }
+            fail("Expected close failure")
+        } catch (_: IllegalStateException) { }
+        slot.close()
+        assertFalse(created)
+        assertEquals(1, first.closes)
+    }
+}
