@@ -0,0 +1,50 @@
+package com.msp1974.vacompanion.wakeword.openwakeword
+
+import org.json.JSONObject
+import java.io.File
+import java.security.MessageDigest
+
+/** Opt-in private assets. Never fetch a model or publish credentials through HA. */
+internal data class ExactWakeConfig(
+    val modelId: String, val label: String, val classifier: File,
+    val mel: File, val embedding: File
+) {
+    companion object {
+        fun load(directory: File, selected: List<String>): ExactWakeConfig? {
+            val manifest = File(directory, "exact-frontend.json")
+            if (!manifest.exists()) return null
+            require(manifest.canonicalFile.parentFile == directory.canonicalFile && manifest.length() in 1..8192) {
+                "Invalid exact frontend manifest"
+            }
+            val data = JSONObject(manifest.readText())
+            val id = data.getString("model_id")
+            if (id !in selected) return null
+            require(selected == listOf(id)) { "Exact frontend requires one selected model" }
+            require(data.getInt("schema_version") == 1 && data.getString("frontend") == "openwakeword-80ms-v1")
+            require(id.matches(Regex("[a-z0-9_]{1,100}")))
+            val label = data.getString("label")
+            require(label.isNotBlank() && label.length <= 100 && label.none { it.isISOControl() })
+            fun verified(key: String, expectedName: String? = null): File {
+                val value = data.getJSONObject(key)
+                val name = value.getString("file")
+                require(name.matches(Regex("[A-Za-z0-9_.-]{1,150}\\.onnx")) && !name.contains(".."))
+                if (expectedName != null) require(name == expectedName)
+                val root = if (key == "classifier") directory else File(directory, "frontend")
+                require(root.canonicalFile == (if (key == "classifier") directory.canonicalFile else File(directory.canonicalFile, "frontend"))) { "Symlinked frontend directory" }
+                val file = File(root, name)
+                require(file.canonicalFile.parentFile == root.canonicalFile && file.isFile && file.length() in 1..50_000_000)
+                val expected = value.getString("sha256")
+                require(expected.matches(Regex("[a-f0-9]{64}")))
+                val digest = MessageDigest.getInstance("SHA-256")
+                file.inputStream().use { input ->
+                    val buffer = ByteArray(65536)
+                    while (true) { val n = input.read(buffer); if (n < 0) break; digest.update(buffer, 0, n) }
+                }
+                val actual = digest.digest().joinToString("") { "%02x".format(it.toInt() and 255) }
+                require(actual == expected) { "Exact frontend asset checksum mismatch: $key" }
+                return file
+            }
+            return ExactWakeConfig(id, label, verified("classifier", "$id.onnx"), verified("mel"), verified("embedding"))
+        }
+    }
+}
