+package com.msp1974.vacompanion.wakeword
+import org.junit.Assert.*
+import org.junit.Test
+class WakeWordSelectionTest {
+    private val models = setOf("custom", "hey_jarvis")
+    @Test fun twoAvailableModels() = assertEquals(listOf("custom", "hey_jarvis"), WakeWordSelection.select("custom", "hey_jarvis", models))
+    @Test fun duplicateIsLoadedOnce() = assertEquals(listOf("custom"), WakeWordSelection.select("custom", "custom", models))
+    @Test fun absentOrUnknownSecondaryPreservesPrimary() {
+        assertEquals(listOf("custom"), WakeWordSelection.select("custom", null, models))
+        assertEquals(listOf("custom"), WakeWordSelection.select("custom", "missing", models))
+    }
+    @Test fun disablingPrimaryDisablesBoth() = assertTrue(WakeWordSelection.select("none", "hey_jarvis", models).isEmpty())
+    @Test fun crossModelCooldownAllowsNextUtterance() {
+        val gate = WakeWordCooldown()
+        assertTrue(gate.accept(100))
+        assertFalse(gate.accept(101))
+        assertFalse(gate.accept(2099))
+        assertTrue(gate.accept(2100))
+    }
+}
