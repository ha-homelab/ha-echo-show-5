+    @Test fun embeddingCallbackAndReturnedWindowsCannotMutateStoredFeatures() {
+        var number = 0
+        val state = FrameAlignedFrontendState(
+            melspectrogram = { _, count -> FloatArray((if (count == 1280) 5 else 8) * 32) },
+            embedding = { FloatArray(96) { number + 1f }.also { number++ } },
+            onEmbedding = { it.fill(-100f) },
+        )
+        val first = state.process(ShortArray(16 * 1280)).single()
+        assertEquals(1f, first[0][0][0], 0f)
+        first[0].forEach { it.fill(-200f) }
+        val second = state.process(ShortArray(1280)).single()
+        assertEquals(2f, second[0][0][0], 0f)
+        assertEquals(17f, second[0][15][0], 0f)
+    }
