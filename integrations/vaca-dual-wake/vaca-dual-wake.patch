@@ -0,0 +1,18 @@
+package com.msp1974.vacompanion.wakeword
+
+/** Owns the current detector in one collection; never closes a retired resource twice. */
+internal class CloseableResource<T : AutoCloseable> : AutoCloseable {
+    private var current: T? = null
+    val value: T get() = checkNotNull(current) { "Resource is not initialized" }
+
+    suspend fun replace(create: suspend () -> T) {
+        close()
+        current = create()
+    }
+
+    override fun close() {
+        val previous = current
+        current = null
+        previous?.close()
+    }
+}
