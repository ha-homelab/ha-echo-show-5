+import org.json.JSONObject
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import kotlin.math.abs
+
+/** Replays explicitly staged private files. Never opens or records a microphone. */
+@RunWith(AndroidJUnit4::class)
+class ExactFrontendParityTest {
+    @Test fun privateManifestRejectsCorruptionAndTraversal() {
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        val directory = File(context.cacheDir, "exact-manifest-check")
+        directory.deleteRecursively(); directory.mkdirs()
+        try {
+            File(directory, "frontend").mkdir()
+            val byte = byteArrayOf(42)
+            val hash = java.security.MessageDigest.getInstance("SHA-256").digest(byte)
+                .joinToString("") { "%02x".format(it.toInt() and 255) }
+            File(directory, "test.onnx").writeBytes(byte)
+            File(directory, "frontend/mel.onnx").writeBytes(byte)
+            File(directory, "frontend/embedding.onnx").writeBytes(byte)
+            fun asset(name: String) = JSONObject().put("file", name).put("sha256", hash)
+            val data = JSONObject().put("schema_version", 1).put("frontend", "openwakeword-80ms-v1")
+                .put("model_id", "test").put("label", "Test")
+                .put("classifier", asset("test.onnx")).put("mel", asset("mel.onnx"))
+                .put("embedding", asset("embedding.onnx"))
+            val manifest = File(directory, "exact-frontend.json")
+            manifest.writeText(data.toString())
+            assertEquals("test", ExactWakeConfig.load(directory, listOf("test"))!!.modelId)
+            assertNull(ExactWakeConfig.load(directory, listOf("different")))
+            assertTrue(runCatching { ExactWakeConfig.load(directory, listOf("test", "different")) }.isFailure)
+            data.getJSONObject("classifier").put("sha256", "0".repeat(64))
+            manifest.writeText(data.toString())
+            assertTrue(runCatching { ExactWakeConfig.load(directory, listOf("test")) }.isFailure)
+            data.getJSONObject("classifier").put("sha256", hash).put("file", "../test.onnx")
+            manifest.writeText(data.toString())
+            assertTrue(runCatching { ExactWakeConfig.load(directory, listOf("test")) }.isFailure)
+        } finally { directory.deleteRecursively() }
+    }
+
+    @Test fun invalidOptionalMetadataKeepsCustomModelsVisible() = runBlocking {
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        val directory = File(context.cacheDir, "exact-discovery-check")
+        directory.deleteRecursively(); directory.mkdirs()
+        try {
+            File(directory, "frontend").mkdir()
+            val bytes = byteArrayOf(42)
+            val hash = java.security.MessageDigest.getInstance("SHA-256").digest(bytes)
+                .joinToString("") { "%02x".format(it.toInt() and 255) }
+            for (name in listOf("custom_model.onnx", "other_model.onnx",
+                "frontend/mel.onnx", "frontend/embedding.onnx")) {
+                File(directory, name).writeBytes(bytes)
+            }
+            fun asset(name: String) = JSONObject().put("file", name).put("sha256", hash)
+            val data = JSONObject().put("schema_version", 1).put("frontend", "openwakeword-80ms-v1")
+                .put("model_id", "custom_model").put("label", "Custom phrase")
+                .put("classifier", asset("custom_model.onnx")).put("mel", asset("mel.onnx"))
+                .put("embedding", asset("embedding.onnx"))
+            val manifest = File(directory, "exact-frontend.json")
+            val provider = OpenWakeWordCustomProvider(context, directory.toPath())
+            suspend fun labels() = provider.get().associate { it.id to it.wakeWord.wake_word }
+            val fallback = mapOf("custom_model" to "Custom Model", "other_model" to "Other Model")
+            assertEquals(fallback, labels()) // No optional manifest.
+            manifest.writeText(data.toString())
+            assertEquals(fallback + ("custom_model" to "Custom phrase"), labels())
+            assertNotNull(ExactWakeConfig.load(directory, listOf("custom_model")))
+
+            manifest.writeText("{broken JSON")
+            assertEquals(fallback, labels()) // Neither custom model disappears.
+            assertTrue(runCatching { ExactWakeConfig.load(directory, listOf("custom_model")) }.isFailure)
+
+            manifest.writeText(data.toString())
+            File(directory, "frontend/embedding.onnx").delete()
+            assertEquals(fallback, labels())
+            assertTrue(runCatching { ExactWakeConfig.load(directory, listOf("custom_model")) }.isFailure)
+
+            File(directory, "frontend/embedding.onnx").writeBytes(byteArrayOf(43))
+            assertEquals(fallback, labels())
+            assertTrue(runCatching { ExactWakeConfig.load(directory, listOf("custom_model")) }.isFailure)
+        } finally { directory.deleteRecursively() }
+    }
+
+    @Test fun privateFixturesMatchReferenceWithFragmentedInput() {
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        val directory = File(context.filesDir, "exact-oww-check")
+        val manifest = JSONObject(File(directory, "fixture.json").readText())
+        val assets = checkNotNull(ExactWakeConfig.load(File(context.filesDir, "custom/wakewords/openwakeword"),
+            listOf(manifest.getString("model_id"))))
+        val env = OrtEnvironment.getEnvironment()
+        fun floats(name: String): FloatArray {
+            val bytes = File(directory, name).readBytes()
+            val b = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN).asFloatBuffer()
+            return FloatArray(b.remaining()).also { b.get(it) }
+        }
+        val results = org.json.JSONArray()
+        OrtSession.SessionOptions().use { options ->
+            options.setIntraOpNumThreads(1); options.setInterOpNumThreads(1)
+            env.createSession(assets.classifier.absolutePath, options).use { session ->
+                val cases = manifest.getJSONArray("cases")
+                for (c in 0 until cases.length()) {
+                    val row = cases.getJSONObject(c)
+                    val input = ByteBuffer.wrap(File(directory, row.getString("pcm")).readBytes())
+                        .order(ByteOrder.LITTLE_ENDIAN).asShortBuffer()
+                    val pcm = ShortArray(input.remaining()).also { input.get(it) }
+                    val embeddings = floats(row.getString("embeddings"))
+                    val scores = floats(row.getString("scores"))
+                    var index = 0; var scoreIndex = 0; var embeddingDelta = 0f; var scoreDelta = 0f
+                    var decisions = 0; var maxBlockNanos = 0L
+                    val started = System.nanoTime()
+                    ExactOnnxFrontend(assets.mel, assets.embedding, onEmbedding = { embedding ->
+                        for (j in embedding.indices) {
+                            embeddingDelta = maxOf(embeddingDelta, abs(embedding[j] - embeddings[index * 96 + j]))
+                        }
+                        index++
+                    }).use { frontend ->
+                        val chunks = intArrayOf(1, 127, 512, 1280, 2048, 2567, 83)
+                        var offset = 0; var chunk = 0
+                        while (offset < pcm.size) {
+                            val end = minOf(pcm.size, offset + chunks[chunk++ % chunks.size])
+                            val before = System.nanoTime()
+                            for (features in frontend.process(pcm.copyOfRange(offset, end))) {
+                                OnnxTensor.createTensor(env, features).use { tensor ->
+                                    session.run(mapOf(session.inputNames.first() to tensor)).use { output ->
+                                        val score = (output[0] as OnnxTensor).floatBuffer.get(0)
+                                        scoreDelta = maxOf(scoreDelta, abs(score - scores[scoreIndex]))
+                                        assertEquals("Threshold decision differs", scores[scoreIndex] >= 0.5f, score >= 0.5f)
+                                        if (score >= 0.5f) decisions++
+                                        scoreIndex++
+                                    }
+                                }
+                            }
+                            maxBlockNanos = maxOf(maxBlockNanos, System.nanoTime() - before)
+                            offset = end
+                        }
+                    }
+                    val elapsedMs = (System.nanoTime() - started) / 1_000_000
+                    assertEquals(embeddings.size / 96, index)
+                    assertEquals(scores.size, scoreIndex)
+                    assertTrue("Embedding parity delta=$embeddingDelta", embeddingDelta < 0.005f)
+                    assertTrue("Classifier parity delta=$scoreDelta", scoreDelta < 0.001f)
+                    results.put(JSONObject().put("case", c).put("embeddings", index).put("windows", scoreIndex)
+                        .put("embedding_max_abs_delta", embeddingDelta.toDouble()).put("score_max_abs_delta", scoreDelta.toDouble())
+                        .put("positive_windows", decisions).put("elapsed_ms", elapsedMs)
+                        .put("audio_ms", pcm.size / 16).put("max_fragment_ms", maxBlockNanos / 1_000_000))
+                }
+            }
+        }
+        File(directory, "android-parity.json").writeText(results.toString(2))
+    }
+}
