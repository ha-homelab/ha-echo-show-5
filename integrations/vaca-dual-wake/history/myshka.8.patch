+package com.msp1974.vacompanion.wakeword.openwakeword
+
+import com.msp1974.vacompanion.wakeword.WakeWordEngineProvider
+
+/** The exact ONNX primary can optionally share its PCM with one bundled micro model. */
+internal object ExactAuxiliaryWakePolicy {
+    const val HEY_JARVIS = "hey_jarvis"
+
+    fun select(primary: String?, requested: String?, exactPrimary: Boolean): String? {
+        if (!exactPrimary || primary.isNullOrBlank() || primary == "none") return null
+        val candidate = requested?.trim()
+        return candidate?.takeIf { it == HEY_JARVIS && it != primary }
+    }
+
+    fun route(
+        detection: WakeWordEngineProvider.WakeWordDetection,
+        auxiliaryWakeWord: String?,
+    ): WakeWordEngineProvider.AudioResult? = when {
+        detection.wakeWordId == "stop" ->
+            WakeWordEngineProvider.AudioResult.StopDetected(detection.copy(modelDecision = null))
+        auxiliaryWakeWord == HEY_JARVIS && detection.wakeWordId == auxiliaryWakeWord ->
+            WakeWordEngineProvider.AudioResult.WakeDetected(
+                detection.copy(modelDecision = detection.detected))
+        else -> null
+    }
+}
