+package com.msp1974.vacompanion.wakeword.openwakeword
+
+import com.msp1974.vacompanion.wakeword.WakeWordEngineProvider.AudioResult
+import com.msp1974.vacompanion.wakeword.WakeWordEngineProvider.WakeWordDetection
+import org.junit.Assert.*
+import org.junit.Test
+
+class ExactAuxiliaryWakePolicyTest {
+    private val primary = "privet_myshka"
+    private val jarvis = ExactAuxiliaryWakePolicy.HEY_JARVIS
+
+    @Test fun exactPrimaryCanOptIntoBundledJarvis() {
+        assertEquals(jarvis, ExactAuxiliaryWakePolicy.select(primary, jarvis, true))
+        assertEquals(jarvis, ExactAuxiliaryWakePolicy.select(primary, "  $jarvis  ", true))
+    }
+
+    @Test fun missingDisabledAndUnknownSecondaryKeepAuxiliaryOff() {
+        for (secondary in listOf(null, "", " ", "none", "stop", "unknown", primary)) {
+            assertNull("Unexpected auxiliary: $secondary",
+                ExactAuxiliaryWakePolicy.select(primary, secondary, true))
+        }
+    }
+
+    @Test fun absentOrDisabledPrimaryCannotLeaveJarvisListeningAlone() {
+        for (disabled in listOf(null, "", " ", "none")) {
+            assertNull(ExactAuxiliaryWakePolicy.select(disabled, jarvis, true))
+        }
+    }
+
+    @Test fun legacyOrDuplicatePrimaryCannotEnableExactAuxiliary() {
+        assertNull(ExactAuxiliaryWakePolicy.select(primary, jarvis, false))
+        assertNull(ExactAuxiliaryWakePolicy.select(jarvis, jarvis, true))
+    }
+
+    @Test fun stopAlwaysUsesStopRouteAndRetainsLegacyThresholdSemantics() {
+        val input = WakeWordDetection("stop", "Stop", false, 0.75f,
+            timestamp = 123L, modelDecision = false)
+        for (secondary in listOf(null, jarvis)) {
+            val routed = ExactAuxiliaryWakePolicy.route(input, secondary)
+            assertTrue(routed is AudioResult.StopDetected)
+            val output = (routed as AudioResult.StopDetected).detection
+            assertEquals(input.copy(modelDecision = null), output)
+        }
+    }
+
+    @Test fun jarvisUsesWakeRouteAndPreservesBothTemporalDecisions() {
+        for (detected in listOf(false, true)) {
+            val input = WakeWordDetection(jarvis, "Hey Jarvis", detected, 0.99f,
+                timestamp = 456L)
+            val routed = ExactAuxiliaryWakePolicy.route(input, jarvis)
+            assertTrue(routed is AudioResult.WakeDetected)
+            val output = (routed as AudioResult.WakeDetected).detection
+            assertEquals(input.copy(modelDecision = detected), output)
+        }
+    }
+
+    @Test fun disabledAndUnknownModelsCannotGenerateActivationEvents() {
+        val input = WakeWordDetection(jarvis, "Hey Jarvis", true, 0.99f)
+        assertNull(ExactAuxiliaryWakePolicy.route(input, null))
+        assertNull(ExactAuxiliaryWakePolicy.route(input, "unknown"))
+        assertNull(ExactAuxiliaryWakePolicy.route(input.copy(wakeWordId = primary), jarvis))
+        assertNull(ExactAuxiliaryWakePolicy.route(input.copy(wakeWordId = "unknown"), jarvis))
+    }
+}
