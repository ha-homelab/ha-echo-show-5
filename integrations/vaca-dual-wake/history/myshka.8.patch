+package com.msp1974.vacompanion.wakeword
+
+/** Preserve a model's calibrated temporal decision instead of rethresholding its raw score. */
+object WakeWordDetectionDecision {
+    fun accept(score: Float, threshold: Float, modelDecision: Boolean? = null): Boolean =
+        score.isFinite() && score in 0f..1f && (modelDecision ?: (score >= threshold))
