@@ -0,0 +1,133 @@
+package com.msp1974.vacompanion.wakeword.openwakeword
+
+import android.Manifest
+import com.msp1974.vacompanion.wakeword.openwakeword.audio.ExactOnnxFrontend
+import android.content.Context
+import androidx.annotation.RequiresPermission
+import ai.onnxruntime.OnnxTensor
+import ai.onnxruntime.OrtEnvironment
+import ai.onnxruntime.OrtSession
+import com.msp1974.vacompanion.audio.AudioDSP
+import com.msp1974.vacompanion.audio.MicrophoneInput
+import com.msp1974.vacompanion.device.DeviceManager
+import com.msp1974.vacompanion.wakeword.WakeWordEngineProvider
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.yield
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.emptyFlow
+import kotlinx.coroutines.flow.flatMapLatest
+import kotlinx.coroutines.flow.flow
+import timber.log.Timber
+
+/** One classifier with the exact private ONNX frontend used during training,
+ * plus an optional bundled micro activation model on the existing Stop frontend.
+ * Resources belong to each collection, so cancellation cannot close another run.
+ * No microphone recordings or audio uploads are added by this implementation.
+ */
+internal class ExactOnnxWakeEngine(
+    private val context: Context, private val deviceManager: DeviceManager,
+    private val assets: ExactWakeConfig, muted: Boolean,
+    private val auxiliaryWakeWord: String? = null
+) : WakeWordEngineProvider() {
+    private val mutedState = MutableStateFlow(muted)
+    override fun setMuted(value: Boolean) { mutedState.value = value }
+    override fun isMuted() = mutedState.value
+
+    @OptIn(ExperimentalCoroutinesApi::class)
+    @RequiresPermission(Manifest.permission.RECORD_AUDIO)
+    override fun start() = mutedState.flatMapLatest { muted ->
+        if (muted) emptyFlow() else flow {
+            val env = OrtEnvironment.getEnvironment()
+            // Nest resource scopes so a failed constructor still closes earlier sessions.
+            ExactOnnxFrontend(assets.mel, assets.embedding).use { frontend ->
+                OrtSession.SessionOptions().use { options ->
+                    options.setIntraOpNumThreads(1); options.setInterOpNumThreads(1)
+                    env.createSession(assets.classifier.absolutePath, options).use { classifier ->
+                        require(classifier.inputNames.size == 1 && classifier.outputNames.size == 1)
+                        LocalStopDetector.create(context, auxiliaryWakeWord).use { stopDetector ->
+                            Timber.i("Exact OWW activation models loaded: %s; local_stop=true",
+                                listOfNotNull(assets.modelId, auxiliaryWakeWord))
+                            val microphone = MicrophoneInput(context, deviceManager)
+                            val dsp = AudioDSP()
+                            var samples = 0L; var windows = 0L; var inferenceNanos = 0L; var maxNanos = 0L
+                            var nextReport = 16000L * 10
+                            var previousScore = 0f
+                            val previousLocalScores = mutableMapOf<String, Float>()
+                            var emptyReads = 0
+                            try {
+                                microphone.start()
+                                Timber.i("Exact OWW loaded: %s; frontend=openwakeword-80ms-v1; threshold=%s; recording=%s", assets.modelId, deviceManager.config.wakeWordThreshold, deviceManager.config.recordingWakewordEnabled)
+                                emit(AudioResult.EngineStatus("Started"))
+                                while (true) {
+                                    currentCoroutineContext().ensureActive()
+                                    val audio = microphone.readShort()
+                                    if (audio.isEmpty()) {
+                                        check(++emptyReads < 50) { "Microphone returned no audio repeatedly" }
+                                        delay(20)
+                                        continue
+                                    }
+                                    emptyReads = 0
+                                    val timestamp = System.currentTimeMillis()
+                                    samples += audio.size
+                                    if (deviceManager.config.diagnosticsEnabled) {
+                                        emit(AudioResult.AudioLevel(dsp.audioLevel(dsp.normaliseAudioBuffer(audio))))
+                                    }
+                                    if (isStreaming || deviceManager.config.recordingWakewordEnabled) {
+                                        emit(AudioResult.Audio(dsp.shortArrayToByteBuffer(audio), timestamp))
+                                    }
+                                    val begin = System.nanoTime()
+                                    val localDetections = stopDetector.process(audio)
+                                    val scores = frontend.process(audio).map { features ->
+                                        currentCoroutineContext().ensureActive()
+                                        OnnxTensor.createTensor(env, features).use { input ->
+                                            classifier.run(mapOf(classifier.inputNames.first() to input)).use { output ->
+                                                val tensor = output[0] as OnnxTensor
+                                                require(tensor.info.shape.contentEquals(longArrayOf(1, 1)))
+                                                val score = tensor.floatBuffer.get(0)
+                                                require(score.isFinite() && score >= 0f && score <= 1f)
+                                                score
+                                            }
+                                        }
+                                    }
+                                    val elapsed = System.nanoTime() - begin
+                                    inferenceNanos += elapsed; maxNanos = maxOf(maxNanos, elapsed)
+                                    windows += scores.size
+                                    for (detection in localDetections) {
+                                        val previous = previousLocalScores[detection.wakeWordId] ?: 0f
+                                        if (detection.score > 0.1f || previous > 0.1f) {
+                                            emit(ExactAuxiliaryWakePolicy.route(
+                                                detection.copy(timestamp = timestamp), auxiliaryWakeWord)
+                                                ?: error("Unexpected local model result"))
+                                        }
+                                        previousLocalScores[detection.wakeWordId] = detection.score
+                                    }
+                                    for (score in scores) {
+                                        if (score > 0.1f || previousScore > 0.1f) {
+                                            emit(AudioResult.WakeDetected(WakeWordDetection(assets.modelId, assets.label,
+                                                score >= deviceManager.config.wakeWordThreshold, score, timestamp = timestamp)))
+                                        }
+                                        previousScore = score
+                                    }
+                                    if (samples >= nextReport) {
+                                        Timber.i("Exact OWW running: samples=%d windows=%d inference_ms=%d max_ms=%d", samples, windows, inferenceNanos / 1000000, maxNanos / 1000000)
+                                        nextReport = samples + 16000L * 60
+                                    }
+                                    // Quiet audio may emit nothing: let flatMapLatest receive mute changes.
+                                    yield()
+                                }
+                            } finally {
+                                microphone.close()
+                                Timber.i("Exact OWW stopped: %s; microphone closed", assets.modelId)
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    // Active collections own their sessions; cancellation/finally performs cleanup.
+    override fun release() = Unit
+}
