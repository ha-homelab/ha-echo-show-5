+package com.msp1974.vacompanion.wakeword
+import org.junit.Assert.*
+import org.junit.Test
+class WakeWordSelectionTest {
+    private val models = setOf("custom", "hey_jarvis")
+    @Test fun twoAvailableModels() = assertEquals(listOf("custom", "hey_jarvis"), WakeWordSelection.select("custom", "hey_jarvis", models))
+    @Test fun duplicateIsLoadedOnce() = assertEquals(listOf("custom"), WakeWordSelection.select("custom", "custom", models))
+    @Test fun absentOrUnknownSecondaryPreservesPrimary() {
+        assertEquals(listOf("custom"), WakeWordSelection.select("custom", null, models))
+        assertEquals(listOf("custom"), WakeWordSelection.select("custom", "missing", models))
+    }
+    @Test fun disablingPrimaryDisablesBoth() = assertTrue(WakeWordSelection.select("none", "hey_jarvis", models).isEmpty())
+    @Test fun crossModelCooldownAllowsNextUtterance() {
+        val gate = WakeWordCooldown()
+        assertTrue(gate.accept(100))
+        assertFalse(gate.accept(101))
+        assertFalse(gate.accept(2099))
+        assertTrue(gate.accept(2100))
+    }
+}
diff --git a/app/src/test/java/com/msp1974/vacompanion/wakeword/openwakeword/audio/FrameAlignedFrontendStateTest.kt b/app/src/test/java/com/msp1974/vacompanion/wakeword/openwakeword/audio/FrameAlignedFrontendStateTest.kt
new file mode 100644
index 0000000..b2afe1b
--- /dev/null
+++ b/app/src/test/java/com/msp1974/vacompanion/wakeword/openwakeword/audio/FrameAlignedFrontendStateTest.kt
@@ -0,0 +1,151 @@
+package com.msp1974.vacompanion.wakeword.openwakeword.audio
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class FrameAlignedFrontendStateTest {
+    private class Fixture {
+        val raw = mutableListOf<FloatArray>()
+        val windows = mutableListOf<FloatArray>()
+        val state = FrameAlignedFrontendState(
+            melspectrogram = { samples, count ->
+                raw.add(samples.copyOf(count))
+                FloatArray((if (count == 1280) 5 else 8) * 32) { raw.size * 10f }
+            },
+            embedding = { window ->
+                windows.add(window.copyOf())
+                FloatArray(96) { windows.size.toFloat() }
+            },
+        )
+    }
+
+    @Test fun firstChunkUsesInt16ScaleAndNextChunkHasExactly480SamplesOfOverlap() {
+        val fixture = Fixture()
+        val first = ShortArray(1280) { (it - 640).toShort() }
+        first[0] = Short.MIN_VALUE
+        first[1] = Short.MAX_VALUE
+        val second = ShortArray(1280) { (it + 1000).toShort() }
+        fixture.state.process(first)
+        fixture.state.process(second)
+        assertArrayEquals(first.map(Short::toFloat).toFloatArray(), fixture.raw[0], 0f)
+        val expected = first.takeLast(480).toShortArray() + second
+        assertArrayEquals(expected.map(Short::toFloat).toFloatArray(), fixture.raw[1], 0f)
+    }
+
+    @Test fun melWindowStartsWithOnesThenAppliesScaleAndOffsetInOrder() {
+        val fixture = Fixture()
+        fixture.state.process(ShortArray(2560))
+        val first = FloatArray(76 * 32) { if (it < 71 * 32) 1f else 3f }
+        val second = FloatArray(76 * 32) {
+            when { it < 63 * 32 -> 1f; it < 68 * 32 -> 3f; else -> 4f }
+        }
+        assertArrayEquals(first, fixture.windows[0], 0f)
+        assertArrayEquals(second, fixture.windows[1], 0f)
+    }
+
+    @Test fun partialReadsAndMultiChunkReadsProduceIdenticalFeatureWindows() {
+        val pcm = ShortArray(18 * 1280 + 97) { (it % 20000 - 10000).toShort() }
+        val full = Fixture()
+        val split = Fixture()
+        val expected = full.state.process(pcm)
+        val actual = mutableListOf<Array<Array<FloatArray>>>()
+        val sizes = intArrayOf(1, 79, 900, 7, 1279, 3601, 32)
+        var position = 0
+        var step = 0
+        while (position < pcm.size) {
+            val end = minOf(pcm.size, position + sizes[step++ % sizes.size])
+            actual.addAll(split.state.process(pcm.copyOfRange(position, end)))
+            position = end
+        }
+        assertEquals(97, split.state.pendingSamples)
+        assertEquals(18L, split.state.processedChunks)
+        assertEquals(expected.size, actual.size)
+        assertEquals(full.raw.size, split.raw.size)
+        full.raw.indices.forEach { assertArrayEquals(full.raw[it], split.raw[it], 0f) }
+        expected.indices.forEach { index ->
+            expected[index][0].indices.forEach { frame ->
+                assertArrayEquals(expected[index][0][frame], actual[index][0][frame], 0f)
+            }
+        }
+    }
+
+    @Test fun classifierWaitsFor16RealEmbeddingsAndAdvancesEveryChunk() {
+        val fixture = Fixture()
+        assertTrue(fixture.state.process(ShortArray(15 * 1280)).isEmpty())
+        val first = fixture.state.process(ShortArray(1280)).single()
+        val second = fixture.state.process(ShortArray(1280)).single()
+        assertEquals(1, first.size)
+        assertEquals(16, first[0].size)
+        assertEquals(96, first[0][0].size)
+        for (index in 0 until 16) {
+            assertEquals(index + 1f, first[0][index][0], 0f)
+            assertEquals(index + 2f, second[0][index][0], 0f)
+        }
+    }
+
+    @Test fun resetDropsPendingAudioContextAndFeatureHistory() {
+        val fixture = Fixture()
+        fixture.state.process(ShortArray(17 * 1280 + 500) { 22 })
+        fixture.state.reset()
+        assertEquals(0, fixture.state.pendingSamples)
+        assertEquals(0L, fixture.state.processedChunks)
+        assertTrue(fixture.state.process(ShortArray(1280) { 33 }).isEmpty())
+        assertEquals(1280, fixture.raw.last().size)
+        assertTrue(fixture.raw.last().all { it == 33f })
+        assertTrue(fixture.windows.last().take(71 * 32).all { it == 1f })
+    }
+
+    @Test fun embeddingCallbackAndReturnedWindowsCannotMutateStoredFeatures() {
+        var number = 0
+        val state = FrameAlignedFrontendState(
+            melspectrogram = { _, count -> FloatArray((if (count == 1280) 5 else 8) * 32) },
+            embedding = { FloatArray(96) { number + 1f }.also { number++ } },
+            onEmbedding = { it.fill(-100f) },
+        )
+        val first = state.process(ShortArray(16 * 1280)).single()
+        assertEquals(1f, first[0][0][0], 0f)
+        first[0].forEach { it.fill(-200f) }
+        val second = state.process(ShortArray(1280)).single()
+        assertEquals(2f, second[0][0][0], 0f)
+        assertEquals(17f, second[0][15][0], 0f)
+    }
+
+    @Test fun inferenceFailureRequiresResetBeforeReusingTheState() {
+        var failMel = true
+        val state = FrameAlignedFrontendState(
+            melspectrogram = { _, count ->
+                if (failMel) error("synthetic inference failure")
+                FloatArray((if (count == 1280) 5 else 8) * 32)
+            },
+            embedding = { FloatArray(96) },
+        )
+        assertTrue(runCatching { state.process(ShortArray(1280)) }.isFailure)
+        failMel = false
+        assertTrue(runCatching { state.process(ShortArray(1280)) }.isFailure)
+        state.reset()
+        assertTrue(state.process(ShortArray(1280)).isEmpty())
+        assertEquals(1L, state.processedChunks)
+    }
+
+    @Test fun invalidMelAndEmbeddingOutputsAreRejected() {
+        val badMel = listOf(FloatArray(32), FloatArray(160) { Float.NaN })
+        badMel.forEach { output ->
+            val state = FrameAlignedFrontendState({ _, _ -> output }, { FloatArray(96) })
+            assertTrue(runCatching { state.process(ShortArray(1280)) }.isFailure)
+        }
+        val badEmbedding = listOf(FloatArray(95), FloatArray(96) { Float.POSITIVE_INFINITY })
+        badEmbedding.forEach { output ->
+            val state = FrameAlignedFrontendState({ _, _ -> FloatArray(160) }, { output })
+            assertTrue(runCatching { state.process(ShortArray(1280)) }.isFailure)
+        }
+    }
+
+    @Test fun emptyInputNeitherScoresNorChangesPendingAudio() {
+        val fixture = Fixture()
+        fixture.state.process(ShortArray(900))
+        assertTrue(fixture.state.process(ShortArray(0)).isEmpty())
+        assertEquals(900, fixture.state.pendingSamples)
+        assertEquals(0L, fixture.state.processedChunks)
+        assertTrue(fixture.raw.isEmpty())
+    }
+}
