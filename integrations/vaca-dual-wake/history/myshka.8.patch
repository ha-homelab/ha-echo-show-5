@@ -0,0 +1,185 @@
+package com.msp1974.vacompanion.wakeword
+
+import java.util.concurrent.atomic.AtomicInteger
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeout
+import org.junit.Assert.*
+import org.junit.Test
+
+class WakeWordSessionTest {
+    private class Fixture(timeoutMs: Long = 2_000) {
+        val parent = SupervisorJob()
+        val scope = CoroutineScope(parent + Dispatchers.Default)
+        val session = WakeWordSession(scope, timeoutMs)
+        val entered = CompletableDeferred<Job>()
+        val cleaning = CompletableDeferred<Unit>()
+        val finishCleanup = CompletableDeferred<Unit>()
+        val closes = AtomicInteger()
+
+        suspend fun start() = session.replace {
+            try {
+                entered.complete(currentCoroutineContext()[Job]!!)
+                awaitCancellation()
+            } finally {
+                withContext(NonCancellable) {
+                    cleaning.complete(Unit)
+                    finishCleanup.await()
+                    closes.incrementAndGet()
+                }
+            }
+        }
+
+        suspend fun dispose() {
+            finishCleanup.complete(Unit)
+            session.stop()
+            parent.cancelAndJoin()
+        }
+    }
+
+    @Test fun stopWaitsForCleanup() = runBlocking {
+        withTimeout(5_000) {
+            val f = Fixture()
+            try {
+                f.start()
+                f.entered.await()
+                val stopping = async { f.session.stop() }
+                f.cleaning.await()
+                assertFalse(stopping.isCompleted)
+                assertEquals(0, f.closes.get())
+                f.finishCleanup.complete(Unit)
+                stopping.await()
+                assertEquals(1, f.closes.get())
+            } finally { f.dispose() }
+        }
+    }
+
+    @Test fun replacementWaitsForPreviousCleanup() = runBlocking {
+        withTimeout(5_000) {
+            val f = Fixture()
+            try {
+                f.start()
+                f.entered.await()
+                val nextStarted = CompletableDeferred<Unit>()
+                val replacing = async {
+                    f.session.replace {
+                        assertEquals(1, f.closes.get())
+                        nextStarted.complete(Unit)
+                        awaitCancellation()
+                    }
+                }
+                f.cleaning.await()
+                assertFalse(nextStarted.isCompleted)
+                assertFalse(replacing.isCompleted)
+                f.finishCleanup.complete(Unit)
+                replacing.await()
+                nextStarted.await()
+            } finally { f.dispose() }
+        }
+    }
+
+    @Test fun cancelledButIncompleteWorkerIsStillJoined() = runBlocking {
+        withTimeout(5_000) {
+            val f = Fixture()
+            try {
+                f.start()
+                val worker = f.entered.await()
+                worker.cancel()
+                f.cleaning.await()
+                assertFalse(worker.isActive)
+                assertFalse(worker.isCompleted)
+                val stopping = async { f.session.stop() }
+                assertFalse(stopping.isCompleted)
+                f.finishCleanup.complete(Unit)
+                stopping.await()
+                assertTrue(worker.isCompleted)
+                assertEquals(1, f.closes.get())
+            } finally { f.dispose() }
+        }
+    }
+
+    @Test fun timeoutRetainsOwnershipAndPreventsReplacement() = runBlocking {
+        withTimeout(5_000) {
+            val f = Fixture(timeoutMs = 30)
+            try {
+                f.start()
+                f.entered.await()
+                try {
+                    f.session.stop()
+                    fail("Blocked cleanup must time out")
+                } catch (_: TimeoutCancellationException) { }
+                val nextStarted = CompletableDeferred<Unit>()
+                try {
+                    f.session.replace { nextStarted.complete(Unit) }
+                    fail("Replacement must not overlap timed-out cleanup")
+                } catch (_: TimeoutCancellationException) { }
+                assertFalse(nextStarted.isCompleted)
+                f.finishCleanup.complete(Unit)
+                f.session.stop()
+                f.session.replace { nextStarted.complete(Unit) }
+                nextStarted.await()
+                assertEquals(1, f.closes.get())
+            } finally { f.dispose() }
+        }
+    }
+
+    @Test fun repeatedStopClosesOnlyOnce() = runBlocking {
+        withTimeout(5_000) {
+            val f = Fixture()
+            try {
+                f.start()
+                f.entered.await()
+                f.finishCleanup.complete(Unit)
+                f.session.stop()
+                f.session.stop()
+                assertEquals(1, f.closes.get())
+            } finally { f.dispose() }
+        }
+    }
+
+    @Test fun parentCancellationClosesOwnedWorker() = runBlocking {
+        withTimeout(5_000) {
+            val f = Fixture()
+            try {
+                f.start()
+                f.entered.await()
+                f.parent.cancel()
+                f.cleaning.await()
+                assertFalse(f.parent.isCompleted)
+                f.finishCleanup.complete(Unit)
+                f.parent.join()
+                assertEquals(1, f.closes.get())
+                assertFalse(f.parent.children.any())
+            } finally { f.dispose() }
+        }
+    }
+
+    @Test fun cancellingStopCallerDoesNotAbandonCleanup() = runBlocking {
+        withTimeout(5_000) {
+            val f = Fixture()
+            try {
+                f.start()
+                f.entered.await()
+                val stopping = launch { f.session.stop() }
+                f.cleaning.await()
+                stopping.cancel()
+                assertFalse(stopping.isCompleted)
+                f.finishCleanup.complete(Unit)
+                stopping.join()
+                assertEquals(1, f.closes.get())
+            } finally { f.dispose() }
+        }
+    }
+}
