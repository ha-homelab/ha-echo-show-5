+package com.msp1974.vacompanion.utils
+
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+
+/** Parse external release metadata without assuming every asset has the expected shape. */
+internal object ReleaseAssets {
+    fun apkDownload(release: JsonObject): String {
+        val assets = release["assets"] as? JsonArray ?: return ""
+        for (element in assets) {
+            val asset = element as? JsonObject ?: continue
+            val type = asset["content_type"] as? JsonPrimitive ?: continue
+            if (!type.isString || type.content != "application/vnd.android.package-archive") continue
+            val url = asset["browser_download_url"] as? JsonPrimitive ?: continue
+            if (url.isString && url.content.isNotBlank()) return url.content
+        }
+        return ""
+    }
+}
