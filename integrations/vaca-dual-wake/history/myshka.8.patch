+package com.msp1974.vacompanion.wakeword.openwakeword.ml
+
+/** A wake classifier returns exactly one finite probability for its single input batch. */
+internal fun scalarPrediction(value: Any?): Float {
+    val batch = value as? Array<*>
+    require(batch != null && batch.size == 1) { "Expected one classifier output batch" }
+    val scores = batch[0] as? FloatArray
+    require(scores != null && scores.size == 1) { "Expected one float classifier score" }
+    val score = scores[0]
+    require(score.isFinite() && score in 0.0f..1.0f) { "Classifier score is not a probability" }
+    return score
+}
