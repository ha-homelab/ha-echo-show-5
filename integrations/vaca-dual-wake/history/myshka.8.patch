+package com.msp1974.vacompanion.wakeword
+
+import android.content.Context
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.msp1974.vacompanion.wakeword.WakeWordEngineProvider.AudioResult
+import com.msp1974.vacompanion.wakeword.WakeWordEngineProvider.WakeWordDetection
+import com.msp1974.vacompanion.wakeword.microwakeword.microwakeword.MicroWakeWord
+import com.msp1974.vacompanion.wakeword.microwakeword.microwakeword.MicroWakeWordDetector
+import com.msp1974.vacompanion.wakeword.microwakeword.providers.MicroWakeWordAssetProvider
+import com.msp1974.vacompanion.wakeword.openwakeword.ExactAuxiliaryWakePolicy
+import com.msp1974.vacompanion.wakeword.openwakeword.LocalStopDetector
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import kotlin.math.abs
+import kotlinx.coroutines.runBlocking
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/** Uses explicitly staged PCM only. Never opens a microphone or plays audio. */
+@RunWith(AndroidJUnit4::class)
+class ExactAuxiliaryParityTest {
+    private val jarvis = ExactAuxiliaryWakePolicy.HEY_JARVIS
+    private val chunks = intArrayOf(1, 127, 512, 1280, 2048, 2567, 83)
+
+    @Test fun auxiliaryLifecycleHonorsDisabledInvalidAndClosedStates() = runBlocking {
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        for (invalid in listOf("", "none", "stop", "unknown")) {
+            assertTrue("Unsupported model must fail before loading: $invalid",
+                runCatching { LocalStopDetector.create(context, invalid) }.exceptionOrNull()
+                    is IllegalArgumentException)
+        }
+        for (secondary in listOf(null, jarvis, null)) {
+            val detector = LocalStopDetector.create(context, secondary)
+            try {
+                assertEquals(if (secondary == null) setOf("stop") else setOf("stop", jarvis),
+                    detector.loadedModelIds)
+                assertTrue(detector.process(ShortArray(0)).isEmpty())
+                assertTrue(detector.process(ShortArray(3200))
+                    .all { it.wakeWordId in detector.loadedModelIds })
+            } finally {
+                detector.close()
+                detector.close() // Lifecycle cleanup must be idempotent.
+            }
+            assertTrue(runCatching { detector.process(ShortArray(1)) }.exceptionOrNull()
+                is IllegalStateException)
+        }
+    }
+
+    @Test fun bundledModelsMatchIndependentFrontendsForPrivateFixtures() = runBlocking {
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        val directory = File(context.filesDir, "exact-oww-check")
+        val cases = JSONObject(File(directory, "fixture.json").readText()).getJSONArray("cases")
+        assertTrue("Existing private parity fixtures are required", cases.length() > 0)
+        val receipt = JSONArray()
+        for (index in 0 until cases.length()) {
+            val row = cases.getJSONObject(index)
+            val pcm = readPcm(directory, row.getString("pcm"))
+            val stats = compareSharedWithIndependent(context, pcm)
+            receipt.put(stats.put("case", index).put("samples", pcm.size))
+        }
+        File(directory, "android-auxiliary-parity.json").writeText(receipt.toString(2))
+    }
+
+    @Test fun syntheticJarvisUsesActivationRouteAndTemporalDecision() = runBlocking {
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        val directory = File(context.filesDir, "exact-oww-check")
+        val cases = JSONObject(File(directory, "auxiliary-fixtures.json").readText())
+            .getJSONArray("cases")
+        assertTrue("Explicitly staged synthetic Jarvis fixtures are required", cases.length() > 0)
+        val receipt = JSONArray()
+        var acceptedJarvisWindows = 0
+        for (index in 0 until cases.length()) {
+            val row = cases.getJSONObject(index)
+            assertEquals("Only positive Jarvis fixtures belong in this acceptance set",
+                jarvis, row.getString("expected"))
+            val pcm = readPcm(directory, row.getString("pcm"))
+            var accepted = 0
+            var highScoresRejected = 0
+            var maxScore = 0f
+            LocalStopDetector.create(context, jarvis).use { detector ->
+                feed(pcm) { fragment ->
+                    for (detection in detector.process(fragment)) {
+                        val routed = ExactAuxiliaryWakePolicy.route(detection, jarvis)
+                        if (detection.wakeWordId == "stop") {
+                            assertTrue(routed is AudioResult.StopDetected)
+                            continue
+                        }
+                        assertEquals(jarvis, detection.wakeWordId)
+                        assertTrue("Jarvis must never use StopDetected", routed is AudioResult.WakeDetected)
+                        val output = (routed as AudioResult.WakeDetected).detection
+                        assertEquals(detection.detected, output.modelDecision)
+                        val decision = WakeWordDetectionDecision.accept(
+                            output.score, 0.50f, output.modelDecision)
+                        assertEquals("Global Myshka threshold must not override Jarvis's temporal gate",
+                            detection.detected, decision)
+                        if (decision) accepted++
+                        if (!decision && detection.score >= 0.50f) highScoresRejected++
+                        maxScore = maxOf(maxScore, detection.score)
+                    }
+                }
+            }
+            acceptedJarvisWindows += accepted
+            receipt.put(JSONObject().put("id", row.getString("id"))
+                .put("samples", pcm.size).put("accepted_jarvis_windows", accepted)
+                .put("high_scores_rejected_by_temporal_gate", highScoresRejected)
+                .put("max_jarvis_score", maxScore.toDouble()))
+        }
+        // Write the diagnostic receipt even when available synthetic voices fail recognition.
+        File(directory, "android-auxiliary-activation.json").writeText(receipt.toString(2))
+        assertTrue("No synthetic Jarvis clip passed its calibrated temporal gate; see receipt",
+            acceptedJarvisWindows > 0)
+    }
+
+    private suspend fun independent(context: Context, id: String): MicroWakeWordDetector {
+        val path = if (id == "stop") "microwakeword/stopWords" else "microwakeword/wakeWords"
+        val entry = MicroWakeWordAssetProvider(context.assets, path).get().single { it.id == id }
+        val model = MicroWakeWord.fromWakeWord(entry)
+        return try {
+            MicroWakeWordDetector(listOf(model))
+        } catch (failure: Throwable) {
+            try { model.close() } catch (closing: Throwable) { failure.addSuppressed(closing) }
+            throw failure
+        }
+    }
+
+    private suspend fun compareSharedWithIndependent(context: Context, pcm: ShortArray): JSONObject {
+        val counts = mutableMapOf("stop" to 0, jarvis to 0)
+        var maxDelta = 0f
+        LocalStopDetector.create(context, jarvis).use { shared ->
+            independent(context, "stop").use { stop ->
+                independent(context, jarvis).use { wake ->
+                    feed(pcm) { fragment ->
+                        val actual = shared.process(fragment)
+                        val references = mapOf("stop" to processReference(stop, fragment),
+                            jarvis to processReference(wake, fragment))
+                        assertTrue(actual.all { it.wakeWordId in references })
+                        for ((id, expected) in references) {
+                            val observed = actual.filter { it.wakeWordId == id }
+                            assertEquals("Window count differs for $id", expected.size, observed.size)
+                            for (index in expected.indices) {
+                                val delta = abs(expected[index].score - observed[index].score)
+                                maxDelta = maxOf(maxDelta, delta)
+                                assertTrue("Shared frontend changes $id score by $delta", delta <= 0.000001f)
+                                assertEquals("Shared frontend changes $id temporal decision",
+                                    expected[index].detected, observed[index].detected)
+                            }
+                            counts[id] = counts.getValue(id) + expected.size
+                        }
+                    }
+                }
+            }
+        }
+        assertTrue("Stop reference produced no windows", counts.getValue("stop") > 0)
+        assertTrue("Jarvis reference produced no windows", counts.getValue(jarvis) > 0)
+        return JSONObject().put("stop_windows", counts.getValue("stop"))
+            .put("jarvis_windows", counts.getValue(jarvis))
+            .put("max_score_abs_delta", maxDelta.toDouble())
+    }
+
+    private fun processReference(detector: MicroWakeWordDetector, audio: ShortArray): List<WakeWordDetection> {
+        val output = mutableListOf<WakeWordDetection>()
+        var offset = 0
+        // Match only LocalStopDetector's bounded PCM transport, not its model selection/routing.
+        while (offset < audio.size) {
+            val end = minOf(audio.size, offset + 1280)
+            val buffer = ByteBuffer.allocateDirect((end - offset) * 2).order(ByteOrder.LITTLE_ENDIAN)
+            for (index in offset until end) buffer.putShort(audio[index])
+            buffer.flip()
+            output.addAll(detector.detect(buffer))
+            offset = end
+        }
+        return output
+    }
+
+    private fun feed(pcm: ShortArray, consume: (ShortArray) -> Unit) {
+        var offset = 0
+        var chunk = 0
+        while (offset < pcm.size) {
+            val end = minOf(pcm.size, offset + chunks[chunk++ % chunks.size])
+            consume(pcm.copyOfRange(offset, end))
+            offset = end
+        }
+    }
+
+    private fun readPcm(directory: File, name: String): ShortArray {
+        val file = File(directory, name).canonicalFile
+        require(file.parentFile == directory.canonicalFile) { "Fixture must be a direct child" }
+        val bytes = file.readBytes()
+        require(bytes.isNotEmpty() && bytes.size % 2 == 0) { "Expected nonempty PCM16LE" }
+        val buffer = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN).asShortBuffer()
+        return ShortArray(buffer.remaining()).also { buffer.get(it) }
+    }
+}
