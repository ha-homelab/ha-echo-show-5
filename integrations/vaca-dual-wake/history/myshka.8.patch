+import org.junit.Test
+
+class WakeWordStartSelectionTest {
+    private val models = setOf("myshka", "hey_jarvis")
+    private val engines = listOf("openwakeword", "openwakeword_rt", "microwakeword")
+
+    @Test fun disabledEngineNeverStartsEvenWithValidModels() {
+        assertNull(WakeWordSelection.forEngine("none", "myshka", "hey_jarvis", models))
+    }
+
+    @Test fun blankOrNonePrimaryDisablesEveryEngine() {
+        for (engine in engines) for (primary in listOf("", " ", "none")) {
+            assertNull(WakeWordSelection.forEngine(engine, primary, "hey_jarvis", models))
+        }
+    }
+
+    @Test fun missingPrimaryDoesNotPromoteJarvisIntoOpenWakeWord() {
+        for (engine in listOf("openwakeword", "openwakeword_rt")) {
+            assertNull(WakeWordSelection.forEngine(engine, "missing", "hey_jarvis", models))
+            assertNull(WakeWordSelection.forEngine(engine, "myshka", null, emptySet()))
+        }
+    }
+
+    @Test fun microWakeWordRetainsAvailableSecondaryFallback() {
+        assertEquals(listOf("hey_jarvis"),
+            WakeWordSelection.forEngine("microwakeword", "missing", "hey_jarvis", models))
+        assertNull(WakeWordSelection.forEngine("microwakeword", "missing", null, models))
