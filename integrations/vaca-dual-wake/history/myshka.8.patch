--- /dev/null
+++ b/app/src/main/java/com/msp1974/vacompanion/wakeword/openwakeword/audio/FrameAlignedFrontendState.kt
@@ -0,0 +1,102 @@
+package com.msp1974.vacompanion.wakeword.openwakeword.audio
+
+/**
+ * Exact 80 ms openWakeWord buffering, independent of Android and the inference runtime.
+ *
+ * One microphone collection owns this object. It is deliberately not thread-safe.
+ * Inference functions consume borrowed arrays synchronously and must not retain them.
+ * Returned windows and optional embedding callbacks receive independent copies.
+ */
+internal class FrameAlignedFrontendState(
+    private val melspectrogram: (FloatArray, Int) -> FloatArray,
+    private val embedding: (FloatArray) -> FloatArray,
+    private val onEmbedding: ((FloatArray) -> Unit)? = null,
+) {
+    companion object {
+        const val CHUNK_SAMPLES = 1280
+        const val CONTEXT_SAMPLES = 480
+        const val MEL_BINS = 32
+        const val MEL_WINDOW = 76
+        const val EMBEDDING_SIZE = 96
+        const val FEATURE_WINDOW = 16
+    }
+
+    private val pending = ShortArray(CHUNK_SAMPLES)
+    private val context = FloatArray(CONTEXT_SAMPLES)
+    private val melInput = FloatArray(CONTEXT_SAMPLES + CHUNK_SAMPLES)
+    private val melWindow = FloatArray(MEL_WINDOW * MEL_BINS) { 1f }
+    private val features = Array(FEATURE_WINDOW) { FloatArray(EMBEDDING_SIZE) }
+    private var hasContext = false
+    private var featureCount = 0
+    private var nextFeature = 0
+    private var failed = false
+
+    var pendingSamples: Int = 0
+        private set
+    var processedChunks: Long = 0
+        private set
+
+    fun process(pcm: ShortArray): List<Array<Array<FloatArray>>> {
+        check(!failed) { "Frontend failed; reset before reusing it" }
+        val output = mutableListOf<Array<Array<FloatArray>>>()
+        var position = 0
+        try {
+            while (position < pcm.size) {
+                val count = minOf(CHUNK_SAMPLES - pendingSamples, pcm.size - position)
+                pcm.copyInto(pending, pendingSamples, position, position + count)
+                pendingSamples += count
+                position += count
+                if (pendingSamples == CHUNK_SAMPLES) {
+                    pendingSamples = 0
+                    advance()?.let(output::add)
+                }
+            }
+        } catch (error: Throwable) {
+            // Part of a chunk may already have reached native inference. Never
+            // silently continue with a state that no longer matches the PCM.
+            failed = true
+            throw error
+        }
+        return output
+    }
+
+    private fun advance(): Array<Array<FloatArray>>? {
+        val offset = if (hasContext) CONTEXT_SAMPLES else 0
+        if (hasContext) context.copyInto(melInput)
+        for (index in pending.indices) melInput[offset + index] = pending[index].toFloat()
+        val mel = melspectrogram(melInput, offset + CHUNK_SAMPLES)
+        val expectedFrames = if (hasContext) 8 else 5
+        require(mel.size == expectedFrames * MEL_BINS) { "Unexpected mel output size" }
+        require(mel.all(Float::isFinite)) { "Mel output contains non-finite values" }
+        val shift = expectedFrames * MEL_BINS
+        melWindow.copyInto(melWindow, 0, shift, melWindow.size)
+        for (index in mel.indices) melWindow[melWindow.size - shift + index] = mel[index] / 10f + 2f
+
+        val feature = embedding(melWindow)
+        require(feature.size == EMBEDDING_SIZE) { "Unexpected embedding output size" }
+        require(feature.all(Float::isFinite)) { "Embedding contains non-finite values" }
+        feature.copyInto(features[nextFeature])
+        nextFeature = (nextFeature + 1) % FEATURE_WINDOW
+        featureCount = minOf(featureCount + 1, FEATURE_WINDOW)
+        for (index in context.indices) context[index] = pending[CHUNK_SAMPLES - CONTEXT_SAMPLES + index].toFloat()
+        hasContext = true
+        processedChunks++
+        onEmbedding?.invoke(feature.copyOf())
+        if (featureCount < FEATURE_WINDOW) return null
+        return arrayOf(Array(FEATURE_WINDOW) { features[(nextFeature + it) % FEATURE_WINDOW].copyOf() })
+    }
+
+    fun reset() {
+        pending.fill(0)
+        context.fill(0f)
+        melInput.fill(0f)
+        melWindow.fill(1f)
+        features.forEach { it.fill(0f) }
+        pendingSamples = 0
+        processedChunks = 0
+        featureCount = 0
+        nextFeature = 0
+        hasContext = false
+        failed = false
+    }
+}
