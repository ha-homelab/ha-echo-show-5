@@ -0,0 +1,44 @@
+package com.msp1974.vacompanion.wakeword
+
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeout
+
+/** A replacement may start only after the previous collection and its cleanup finish. */
+internal class WakeWordSession(
+    private val scope: CoroutineScope,
+    private val stopTimeoutMs: Long = 5_000,
+) {
+    private val mutex = Mutex()
+    private var worker: Job? = null
+
+    suspend fun replace(block: suspend CoroutineScope.() -> Unit) = mutex.withLock {
+        stopLocked()
+        currentCoroutineContext().ensureActive()
+        scope.coroutineContext.ensureActive()
+        worker = scope.launch(start = CoroutineStart.LAZY, block = block).also { it.start() }
+    }
+
+    suspend fun stop() = withContext(NonCancellable) {
+        mutex.withLock { stopLocked() }
+    }
+
+    private suspend fun stopLocked() {
+        val previous = worker ?: return
+        // isActive becomes false before finally/child cleanup finishes. Join even then.
+        // A timeout retains ownership and propagates: never overlap a replacement.
+        withContext(NonCancellable) {
+            withTimeout(stopTimeoutMs) { previous.cancelAndJoin() }
+        }
+        worker = null
+    }
+}
diff --git a/app/src/test/java/com/msp1974/vacompanion/wakeword/WakeWordSessionTest.kt b/app/src/test/java/com/msp1974/vacompanion/wakeword/WakeWordSessionTest.kt
