+package com.msp1974.vacompanion.wakeword
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class WakeWordDetectionDecisionTest {
+    @Test fun exactPrimaryKeepsInclusiveRawThreshold() {
+        assertFalse(WakeWordDetectionDecision.accept(0.4999f, 0.50f))
+        assertTrue(WakeWordDetectionDecision.accept(0.50f, 0.50f))
+        assertTrue(WakeWordDetectionDecision.accept(0.5001f, 0.50f))
+    }
+
+    @Test fun changingGlobalThresholdStillAppliesToModelsWithoutTemporalGate() {
+        assertTrue(WakeWordDetectionDecision.accept(0.4f, 0.35f))
+        assertFalse(WakeWordDetectionDecision.accept(0.4f, 0.50f))
+    }
+
+    @Test fun isolatedHighJarvisScoreCannotBypassTemporalGate() {
+        assertFalse(WakeWordDetectionDecision.accept(0.99f, 0.50f, false))
+        assertFalse(WakeWordDetectionDecision.accept(1f, 0f, false))
+    }
+
+    @Test fun calibratedTemporalDecisionIsNotRethresholded() {
+        assertTrue(WakeWordDetectionDecision.accept(0.98f, 0.99f, true))
+    }
+
+    @Test fun nonFiniteOrOutOfRangeScoresAreRejectedEvenWithModelApproval() {
+        for (score in listOf(Float.NaN, Float.POSITIVE_INFINITY, Float.NEGATIVE_INFINITY,
+            -0.0001f, 1.0001f)) {
+            for (decision in listOf(null, false, true)) {
+                assertFalse("Invalid score $score with model decision $decision",
+                    WakeWordDetectionDecision.accept(score, 0.50f, decision))
+            }
+        }
+    }
+
+    @Test fun validScoreBoundariesRemainAcceptedWhenAppropriate() {
+        assertTrue(WakeWordDetectionDecision.accept(0f, 0f))
+        assertTrue(WakeWordDetectionDecision.accept(1f, 1f))
+        assertFalse(WakeWordDetectionDecision.accept(0f, 0.50f))
+    }
+}
