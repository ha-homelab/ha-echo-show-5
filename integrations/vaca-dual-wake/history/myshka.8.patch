+package com.msp1974.vacompanion.wakeword.openwakeword.ml
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Test
+
+class ScalarPredictionTest {
+    @Test fun acceptsSingleFiniteProbability() {
+        for (score in listOf(0.0f, 0.5f, 1.0f)) assertEquals(score, scalarPrediction(arrayOf(floatArrayOf(score))), 0.0f)
+    }
+
+    @Test fun rejectsWrongTypesAndDimensions() {
+        for (value in listOf(null, 1.0f, floatArrayOf(0.5f), emptyArray<FloatArray>(), arrayOf(floatArrayOf()), arrayOf(floatArrayOf(0.1f, 0.2f)), arrayOf(floatArrayOf(0.1f), floatArrayOf(0.2f)), arrayOf(doubleArrayOf(0.5)))) {
+            assertThrows(IllegalArgumentException::class.java) { scalarPrediction(value) }
+        }
+    }
+
+    @Test fun rejectsNonFiniteOrOutOfRangeScores() {
+        for (score in listOf(Float.NaN, Float.POSITIVE_INFINITY, Float.NEGATIVE_INFINITY, -0.01f, 1.01f)) {
+            assertThrows(IllegalArgumentException::class.java) { scalarPrediction(arrayOf(floatArrayOf(score))) }
+        }
+    }
+}
