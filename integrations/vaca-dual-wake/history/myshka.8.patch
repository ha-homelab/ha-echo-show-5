@@ -0,0 +1,29 @@
+package com.msp1974.vacompanion.wakeword
+
+/** One microphone/frontend; at most two distinct, available activation models. */
+object WakeWordSelection {
+    /** Null means no compatible activation model, so no engine may be constructed. */
+    fun forEngine(engine: String, primary: String, secondary: String?, available: Set<String>): List<String>? {
+        if (engine == "none") return null
+        return select(primary, secondary.takeIf { engine == "microwakeword" }, available)
+            .takeIf { it.isNotEmpty() }
+    }
+
+    fun select(primary: String, secondary: String?, available: Set<String>): List<String> {
+        if (primary.isBlank() || primary == "none") return emptyList()
+        return listOfNotNull(primary, secondary?.trim())
+            .filter { it.isNotEmpty() && it != "none" && it in available }
+            .distinct().take(2)
+    }
+}
+
+/** Suppress duplicate triggers across different models for the same utterance. */
+class WakeWordCooldown(private val durationMs: Long = 2000L) {
+    private var lastAccepted: Long? = null
+    fun accept(now: Long): Boolean {
+        val previous = lastAccepted
+        if (previous != null && now - previous < durationMs) return false
+        lastAccepted = now
+        return true
+    }
+}
