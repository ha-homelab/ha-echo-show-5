new file mode 100644
index 0000000..e3ce3fe
--- /dev/null
+++ b/app/src/main/java/com/msp1974/vacompanion/wakeword/openwakeword/audio/ExactOnnxFrontend.kt
@@ -0,0 +1,100 @@
+package com.msp1974.vacompanion.wakeword.openwakeword.audio
+
+import ai.onnxruntime.OnnxTensor
+import ai.onnxruntime.OrtEnvironment
+import ai.onnxruntime.OrtSession
+import java.io.File
+import java.nio.FloatBuffer
+
+/** Uses the pinned ONNX frontend files supplied by the private model manifest. */
+internal class ExactOnnxFrontend(
+    melFile: File,
+    embeddingFile: File,
+    onEmbedding: ((FloatArray) -> Unit)? = null,
+) : AutoCloseable {
+    // OrtEnvironment is process-wide; this instance owns sessions, never the environment.
+    private val environment = OrtEnvironment.getEnvironment()
+    private val sessions: Pair<OrtSession, OrtSession> = createSessions(melFile, embeddingFile)
+    private var closed = false
+    private val state = FrameAlignedFrontendState(::mel, ::embed, onEmbedding)
+
+    val processedChunks: Long get() = state.processedChunks
+    val pendingSamples: Int get() = state.pendingSamples
+
+    private fun createSession(file: File): OrtSession {
+        require(file.isFile) { "Frontend model file is missing" }
+        return OrtSession.SessionOptions().use { options ->
+            options.setInterOpNumThreads(1)
+            options.setIntraOpNumThreads(1)
+            options.setExecutionMode(OrtSession.SessionOptions.ExecutionMode.SEQUENTIAL)
+            // CPU is the default provider. Do not add NNAPI/GPU precision variants.
+            environment.createSession(file.absolutePath, options)
+        }
+    }
+
+    private fun createSessions(melFile: File, embeddingFile: File): Pair<OrtSession, OrtSession> {
+        val mel = createSession(melFile)
+        try {
+            val embedding = createSession(embeddingFile)
+            try {
+                require(mel.inputNames.size == 1 && mel.outputNames.size == 1 &&
+                    embedding.inputNames.size == 1 && embedding.outputNames.size == 1) {
+                    "Frontend models must have one input and one output"
+                }
+                return Pair(mel, embedding)
+            } catch (error: Throwable) {
+                try { embedding.close() } catch (closing: Throwable) { error.addSuppressed(closing) }
+                throw error
+            }
+        } catch (error: Throwable) {
+            try { mel.close() } catch (closing: Throwable) { error.addSuppressed(closing) }
+            throw error
+        }
+    }
+
+    private fun infer(session: OrtSession, input: FloatArray, count: Int,
+                      shape: LongArray, expectedShape: LongArray): FloatArray {
+        OnnxTensor.createTensor(environment, FloatBuffer.wrap(input, 0, count), shape).use { tensor ->
+            session.run(mapOf(session.inputNames.first() to tensor)).use { result ->
+                val output = result[0] as? OnnxTensor
+                    ?: error("Frontend output is not a tensor")
+                require(output.info.shape.contentEquals(expectedShape)) { "Unexpected frontend output shape" }
+                val buffer = output.floatBuffer
+                val expectedCount = expectedShape.fold(1L) { total, dimension -> total * dimension }.toInt()
+                require(buffer.remaining() == expectedCount) { "Unexpected frontend output length" }
+                return FloatArray(expectedCount).also { buffer.get(it) }
+            }
+        }
+    }
+
+    private fun mel(input: FloatArray, count: Int): FloatArray {
+        val frames = if (count == FrameAlignedFrontendState.CHUNK_SAMPLES) 5L else 8L
+        return infer(sessions.first, input, count, longArrayOf(1, count.toLong()),
+            longArrayOf(1, 1, frames, 32))
+    }
+
+    private fun embed(input: FloatArray): FloatArray = infer(sessions.second, input, input.size,
+        longArrayOf(1, 76, 32, 1), longArrayOf(1, 1, 1, 96))
+
+    fun process(pcm: ShortArray): List<Array<Array<FloatArray>>> {
+        check(!closed) { "Frontend is closed" }
+        return state.process(pcm)
+    }
+
+    fun reset() {
+        check(!closed) { "Frontend is closed" }
+        state.reset()
+    }
+
+    override fun close() {
+        if (closed) return
+        closed = true
+        state.reset()
+        var failure: Throwable? = null
+        try { sessions.second.close() } catch (error: Throwable) { failure = error }
+        try { sessions.first.close() } catch (error: Throwable) {
+            if (failure == null) failure = error else failure.addSuppressed(error)
+        }
+        failure?.let { throw it }
+    }
+}
