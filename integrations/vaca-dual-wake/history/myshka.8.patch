+package com.msp1974.vacompanion.utils
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonObject
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class ReleaseAssetsTest {
+    private fun download(json: String) = ReleaseAssets.apkDownload(Json.parseToJsonElement(json).jsonObject)
+    private val apk = """{"content_type":"application/vnd.android.package-archive","browser_download_url":"https://example.invalid/app.apk"}"""
+
+    @Test fun missingOrNonArrayAssetsReturnEmpty() {
+        for (json in listOf("{}", """{"assets":null}""", """{"assets":{}}""", """{"assets":"wrong"}""")) {
+            assertEquals("", download(json))
+        }
+    }
+
+    @Test fun malformedEntriesDoNotHideLaterApk() {
+        assertEquals("https://example.invalid/app.apk", download("""{"assets":[null,5,"bad",[],{},$apk]}"""))
+    }
+
+    @Test fun wrongContentTypesDoNotSelectAsset() {
+        assertEquals("", download("""{"assets":[{"content_type":[],"browser_download_url":"https://example.invalid/a"},{"content_type":"text/plain","browser_download_url":"https://example.invalid/b"}]}"""))
+    }
+
+    @Test fun emptyOrNonStringUrlsAreSkipped() {
+        for (url in listOf("null", "123", "[]", "{}", "\"\"", "\"  \"")) {
+            val bad = """{"content_type":"application/vnd.android.package-archive","browser_download_url":$url}"""
+            assertEquals("https://example.invalid/app.apk", download("""{"assets":[$bad,$apk]}"""))
+        }
+    }
+
+    @Test fun firstValidApkWins() {
+        val second = apk.replace("app.apk", "second.apk")
+        assertEquals("https://example.invalid/app.apk", download("""{"assets":[$apk,$second]}"""))
+    }
+}
