+package com.msp1974.vacompanion.wakeword.openwakeword
+
+import org.json.JSONObject
+import java.io.File
+import java.security.MessageDigest
+
+/** Opt-in private assets. Never fetch a model or publish credentials through HA. */
+internal data class ExactWakeConfig(
+    val modelId: String, val label: String, val classifier: File,
+    val mel: File, val embedding: File
+) {
+    companion object {
+        fun load(directory: File, selected: List<String>): ExactWakeConfig? {
+            val manifest = File(directory, "exact-frontend.json")
+            if (!manifest.exists()) return null
+            require(manifest.canonicalFile.parentFile == directory.canonicalFile && manifest.length() in 1..8192) {
+                "Invalid exact frontend manifest"
+            }
+            val data = JSONObject(manifest.readText())
+            val id = data.getString("model_id")
+            if (id !in selected) return null
+            require(selected == listOf(id)) { "Exact frontend requires one selected model" }
+            require(data.getInt("schema_version") == 1 && data.getString("frontend") == "openwakeword-80ms-v1")
+            require(id.matches(Regex("[a-z0-9_]{1,100}")))
+            val label = data.getString("label")
+            require(label.isNotBlank() && label.length <= 100 && label.none { it.isISOControl() })
+            fun verified(key: String, expectedName: String? = null): File {
+                val value = data.getJSONObject(key)
+                val name = value.getString("file")
+                require(name.matches(Regex("[A-Za-z0-9_.-]{1,150}\\.onnx")) && !name.contains(".."))
+                if (expectedName != null) require(name == expectedName)
+                val root = if (key == "classifier") directory else File(directory, "frontend")
+                require(root.canonicalFile == (if (key == "classifier") directory.canonicalFile else File(directory.canonicalFile, "frontend"))) { "Symlinked frontend directory" }
+                val file = File(root, name)
+                require(file.canonicalFile.parentFile == root.canonicalFile && file.isFile && file.length() in 1..50_000_000)
+                val expected = value.getString("sha256")
+                require(expected.matches(Regex("[a-f0-9]{64}")))
+                val digest = MessageDigest.getInstance("SHA-256")
+                file.inputStream().use { input ->
+                    val buffer = ByteArray(65536)
+                    while (true) { val n = input.read(buffer); if (n < 0) break; digest.update(buffer, 0, n) }
+                }
+                val actual = digest.digest().joinToString("") { "%02x".format(it.toInt() and 255) }
+                require(actual == expected) { "Exact frontend asset checksum mismatch: $key" }
+                return file
+            }
+            return ExactWakeConfig(id, label, verified("classifier", "$id.onnx"), verified("mel"), verified("embedding"))
+        }
+    }
+}
diff --git a/app/src/main/java/com/msp1974/vacompanion/wakeword/openwakeword/LocalStopDetector.kt b/app/src/main/java/com/msp1974/vacompanion/wakeword/openwakeword/LocalStopDetector.kt
new file mode 100644
index 0000000..04621c5
--- /dev/null
+++ b/app/src/main/java/com/msp1974/vacompanion/wakeword/openwakeword/LocalStopDetector.kt
@@ -0,0 +1,87 @@
+package com.msp1974.vacompanion.wakeword.openwakeword
+
+import android.content.Context
+import com.msp1974.vacompanion.wakeword.WakeWordEngineProvider
+import com.msp1974.vacompanion.wakeword.microwakeword.microwakeword.MicroWakeWord
+import com.msp1974.vacompanion.wakeword.microwakeword.microwakeword.MicroWakeWordDetector
+import com.msp1974.vacompanion.wakeword.microwakeword.providers.MicroWakeWordAssetProvider
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import timber.log.Timber
+
+/**
+ * Existing bundled stop model and optional Jarvis model on the exact detector's PCM.
+ * Both micro models share one MicroFrontend. Owns no microphone.
+ */
+internal class LocalStopDetector private constructor(
+    private val detector: MicroWakeWordDetector,
+    private val pcm: ByteBuffer,
+    val loadedModelIds: Set<String>,
+) : AutoCloseable {
+    private var closed = false
+
+    fun process(audio: ShortArray): List<WakeWordEngineProvider.WakeWordDetection> {
+        check(!closed) { "Stop detector is closed" }
+        val results = mutableListOf<WakeWordEngineProvider.WakeWordDetection>()
+        var offset = 0
+        while (offset < audio.size) {
+            val count = minOf(pcm.capacity() / 2, audio.size - offset)
+            pcm.clear()
+            for (index in offset until offset + count) pcm.putShort(audio[index])
+            pcm.flip()
+            results.addAll(detector.detect(pcm))
+            offset += count
+        }
+        return results
+    }
+
+    override fun close() {
+        if (closed) return
+        closed = true
+        pcm.clear()
+        while (pcm.hasRemaining()) pcm.put(0.toByte())
+        pcm.clear()
+        // MicroWakeWordDetector owns and closes its single MicroFrontend and every model.
+        detector.close()
+    }
+
+    companion object {
+        suspend fun create(context: Context, auxiliaryWakeWord: String? = null): LocalStopDetector {
+            require(auxiliaryWakeWord == null || auxiliaryWakeWord == ExactAuxiliaryWakePolicy.HEY_JARVIS) {
+                "Unsupported exact auxiliary wake model"
+            }
+            val stop = MicroWakeWordAssetProvider(context.assets, "microwakeword/stopWords")
+                .get().singleOrNull { it.id == "stop" }
+                ?: error("Bundled local stop model is missing or ambiguous")
+            val auxiliary = auxiliaryWakeWord?.let { id ->
+                MicroWakeWordAssetProvider(context.assets, "microwakeword/wakeWords")
+                    .get().singleOrNull { it.id == id }
+                    ?: error("Bundled auxiliary wake model is missing or ambiguous")
+            }
+            val entries = listOfNotNull(stop, auxiliary)
+            val pcm = ByteBuffer.allocateDirect(1280 * 2).order(ByteOrder.LITTLE_ENDIAN)
+            val models = mutableListOf<MicroWakeWord>()
+            val detector = try {
+                for (entry in entries) models.add(MicroWakeWord.fromWakeWord(entry))
+                MicroWakeWordDetector(models)
+            } catch (error: Throwable) {
+                for (model in models.asReversed()) {
+                    try { model.close() } catch (closing: Throwable) { error.addSuppressed(closing) }
+                }
+                throw error
+            }
+            return try {
+                LocalStopDetector(detector, pcm, entries.map { it.id }.toSet()).also {
+                    Timber.i("Loaded local stop model: stop")
+                    auxiliary?.let { entry ->
+                        Timber.i("Loaded exact auxiliary wake model: %s; probability_cutoff=%s; sliding_window=%s; shared_micro_frontend=true",
+                            entry.id, entry.wakeWord.micro.probability_cutoff, entry.wakeWord.micro.sliding_window_size)
+                    }
+                }
+            } catch (error: Throwable) {
+                try { detector.close() } catch (closing: Throwable) { error.addSuppressed(closing) }
+                throw error
+            }
+        }
+    }
+}
