FROM python:3.15-slim@sha256:63bb298d2b7b88f176f51b5189f54ce6535c997682ea70885d2132f5d473a8a5
WORKDIR /app
COPY cloud-requirements.txt .
RUN pip install --no-cache-dir --require-hashes -r cloud-requirements.txt
COPY cloud_speech.py .
COPY riva_proto ./riva_proto
USER 65532:65532
EXPOSE 10500
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python", "/app/cloud_speech.py"]
