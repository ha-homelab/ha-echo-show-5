+import { createCommandServer, createCommandServerTransport, type CommandServerConfig } from "./command-server";
+import { dispatchRemoteCommand, executeRemoteRequest } from "../commands/remote-requests";
+
+/** Private, installation-scoped values; deliberately outside PlayerSettings. */
+export function isCommandServerPrivateKey(key: string): boolean {
+    return key === "commandServerAddress" || key === "commandServerToken" || key === "commandServerEnabled";
+}
+
+export function readCommandServerConfig(w: any): CommandServerConfig {
+    function get(key: string): string { return typeof w.stbGetItem === "function" ? String(w.stbGetItem(key) || "") : ""; }
+    return { address: get("commandServerAddress"), token: get("commandServerToken"), enabled: get("commandServerEnabled") === "1" };
+}
+
+function persistCommandServerConfig(w: any, config: CommandServerConfig): void {
+    function write(key: string, value: string): void {
+        if (typeof w.stbSetItem !== "function" || typeof w.stbGetItem !== "function") throw new Error("Private command settings are unavailable.");
+        w.stbSetItem(key, value);
+        if (String(w.stbGetItem(key) || "") !== value) throw new Error("Could not save private command settings.");
+    }
+    write("commandServerEnabled", "0");
+    write("commandServerAddress", config.address);
+    write("commandServerToken", config.token);
+    if (config.enabled) write("commandServerEnabled", "1");
+}
+
+/** Import may revoke consent, never import another device's control credentials. */
+export function preserveCommandServerOnImport(w: any, replace: () => void): void {
+    var retained = readCommandServerConfig(w);
+    retained.enabled = false;
+    if (w.__ottCommandServer) w.__ottCommandServer.configure(retained);
+    try { replace(); }
+    finally {
+        if (typeof w.stbSetItem === "function") persistCommandServerConfig(w, retained);
+    }
+}
+
+export function installCommandServer(w: any, nativeRequest?: (request: any) => Promise<any>): any {
+    return createCommandServer(w, createCommandServerTransport(w, nativeRequest), function (config) {
+        persistCommandServerConfig(w, config);
+    }, dispatchRemoteCommand, executeRemoteRequest);
+}
