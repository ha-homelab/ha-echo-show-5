+
+export interface SwopSessionResponse {
+    code?: string;
+    error?: string;
+    expiresIn?: number;
+    url?: string;
+}
+
+export interface SwopValueResponse {
+    error?: string;
+    status?: string;
+    value?: string;
+}
+
+export const wire = {
+    ackBatchMax: 50,
+    ackPath: "/api/webhook/commands/ack",
+    clientCommandIdPattern: "^[A-Za-z0-9_-]{1,128}$",
+    commandEnvelopeMax: 256,
+    commandPath: "/api/webhook/commands",
+    deviceIdPattern: "^[A-Za-z0-9._:-]{1,128}$",
+    legacyNotifyPath: "/webhook/notify",
+    legacyPollPath: "/webhook/poll",
+    serverCommandIdPattern: "^[0-9a-f]{32}$",
+    swopCaptionLimit: 200,
+    swopClientHeader: "X-Swop-Client-Id",
+    swopClientIdPattern: "^[A-Za-z0-9._:-]{8,128}$",
+    swopCodeAlphabet: "ABCDEFGHJKLMNPQRSTUVWXYZ23456789",
+    swopCodeLength: 6,
+    swopDefaultTtl: 600,
+    swopDraftLimit: 4000,
+    swopFallbackClientHeader: "X-Ottplay-Client-Id",
+    swopNoteLimit: 200,
+    swopSessionPath: "/session",
+    swopSubmitPath: "/submit",
+    swopValueLimit: 8000,
+    swopValuePath: "/val",
+    tokenPattern: "^[A-Za-z0-9_-]{32,256}$",
+};
