+/** Keep Android WebView's fallback play poster out of the media surface. */
+function configurePlainVideoSurface(media: HTMLVideoElement): void {
+    // An absent/empty poster asks WebChromeClient for its default graphic.
+    // Use an explicit transparent pixel instead; decoded frames still replace it.
+    media.poster =
+        "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
+    media.controls = false;
+    media.setAttribute("playsinline", "");
+    media.setAttribute("disableremoteplayback", "");
+    media.setAttribute("controlslist", "noremoteplayback");
+    (media as any).disableRemotePlayback = true;
+}
