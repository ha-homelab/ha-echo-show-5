@@ -0,0 +1,83 @@
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const vm = require("node:vm");
+const ts = require("typescript");
+const { JSDOM } = require("jsdom");
+const root = path.resolve(__dirname, "..");
+const ast = ts.createSourceFile("index.ts", fs.readFileSync(path.join(root, "src/index.ts"), "utf8"), ts.ScriptTarget.Latest, true);
+const entry = ast.statements.find((node) => ts.isFunctionDeclaration(node) && node.name?.text === "startPlayer");
+assert.ok(entry, "production entry point exists");
+const script = ts.transpileModule(entry.getText(ast).replace(/^export /, ""), {
+    compilerOptions: { target: ts.ScriptTarget.ES5, module: ts.ModuleKind.None },
+}).outputText;
+function boot(failure) {
+    const dom = new JSDOM('<div id="launch"><span id="boot-status">Starting…</span></div>', { url: "https://localhost" });
+    const calls = [];
+    const context = {
+        window: dom.window,
+        document: dom.window.document,
+        hostUrl: "",
+        PLAYER_VERSION: "test",
+        console: { log() {}, error() {} },
+        onPlayerStart() { calls.push("start"); },
+        storage: { reset() { calls.push("storage"); } },
+        uiInit() { if (failure) throw new Error("Synthetic startup failure"); calls.push("ui"); },
+        initBackgroundIntervals() { calls.push("intervals"); },
+        stbInit() { calls.push("media"); return true; },
+        onStbReady() { calls.push("ready"); },
+    };
+    vm.createContext(context);
+    vm.runInContext(script + "\nstartPlayer();", context);
+    return { dom, calls };
+}
+const normal = boot(false);
+assert.deepEqual(normal.calls, ["start", "storage", "ui", "intervals", "media", "ready"]);
+assert.equal(normal.dom.window.document.querySelectorAll("#launch img").length, 0, "startup must not insert a decorative play/logo image");
+assert.equal(normal.dom.window.document.querySelector("#boot-status").textContent, "Starting…", "real boot progress remains visible");
+const failed = boot(true);
+assert.match(failed.dom.window.document.querySelector("#launch").textContent, /Synthetic startup failure/, "startup errors remain visible");
+assert.ok(!failed.calls.includes("ready"), "failed startup must not report media ready");
+console.log("PASS Show5 startup has no decorative image and preserves progress/errors");
+
+// Run the production media bootstrap, including its real loading/error handlers.
+// A missing/empty HTML poster falls back to WebChromeClient's large play graphic.
+const coreAst = ts.createSourceFile("core.ts", fs.readFileSync(path.join(root, "src/core/index.ts"), "utf8"), ts.ScriptTarget.Latest, true);
+const coreBootstrap = coreAst.statements.filter((node) => ts.isFunctionDeclaration(node) && ["configurePlainVideoSurface", "stbInit"].includes(node.name?.text)).map((node) => node.getText(coreAst).replace(/^export /, "")).join("\n");
+const mediaDom = new JSDOM('<div id="buffering"></div><div id="video_res"></div><div id="pip_buffering"></div>', { runScripts: "dangerously", url: "https://localhost" });
+const w = mediaDom.window;
+w.eval(fs.readFileSync(path.join(root, "js/jquery-1.11.1.min.js"), "utf8"));
+const errors = [];
+Object.assign(w, {
+    video: null, videoPip: null, playerMode: 1,
+    videoEvent() {}, stbToFullScreen() {}, installTauriFsKeyCapture() {},
+    setInterval() { return 1; },
+});
+w.console.error = (error) => errors.push(error);
+w.eval(ts.transpileModule(coreBootstrap, { compilerOptions: { target: ts.ScriptTarget.ES5, module: ts.ModuleKind.None } }).outputText);
+w.stbInit();
+assert.deepEqual(errors, [], "media bootstrap succeeds");
+for (const id of ["video", "videopip"]) {
+    const media = w.document.getElementById(id);
+    assert.match(media.poster, /^data:image\/gif;base64,/, "explicit embedded poster suppresses the platform default");
+    const gif = Buffer.from(media.poster.split(",")[1], "base64");
+    assert.equal(gif.readUInt16LE(6), 1);
+    assert.equal(gif.readUInt16LE(8), 1);
+    const gce = gif.indexOf(Buffer.from([0x21, 0xf9, 0x04]));
+    assert.ok(gce >= 0 && (gif[gce + 3] & 1), "poster pixel is transparent");
+    assert.equal(media.controls, false, "keep OTTPlay's custom controls");
+    assert.equal(media.disableRemotePlayback, true);
+    assert.ok(media.hasAttribute("disableremoteplayback"));
+    assert.ok(media.hasAttribute("playsinline"));
+}
+assert.equal(w.video.style.objectFit, "contain", "video retains its natural aspect ratio");
+w.video.dispatchEvent(new w.Event("loadstart"));
+assert.notEqual(w.document.getElementById("buffering").style.display, "none");
+w.video.dispatchEvent(new w.Event("playing"));
+assert.equal(w.document.getElementById("buffering").style.display, "none");
+Object.defineProperty(w.video, "error", { value: { code: 4, message: "Synthetic unsupported stream" } });
+w.video.dispatchEvent(new w.Event("error"));
+assert.match(w.document.getElementById("video_res").textContent, /error 4 SRC_NOT_SUPPORTED/);
+assert.equal(w.document.querySelectorAll("#vdiv img").length, 0);
+w.close();
+console.log("PASS Show5 video has transparent posters, no Cast overlay, and visible loading/errors");
