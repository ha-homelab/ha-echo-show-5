            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "grid",
                  "columns": 2,
                  "square": false,
                  "cards": [
                    {
                      "type": "button",
                      "name": "Wake screen",
                      "icon": "mdi:monitor",
                      "icon_height": "28px",
                      "show_state": false,
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "script.turn_on",
