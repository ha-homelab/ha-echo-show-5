{
  "title": "Show panel",
  "views": [
    {
      "title": "Home",
      "path": "home",
      "icon": "mdi:home",
      "type": "panel",
      "cards": [
        {
          "type": "grid",
          "columns": 2,
          "square": false,
          "cards": [
            {
              "type": "entities",
              "show_header_toggle": false,
              "entities": [
                {
                  "entity": "${VOICE_SATELLITE}",
                  "name": "Voice"
                },
                {
                  "entity": "${SCREEN_AWAKE}",
                  "name": "Screen awake"
                },
                {
                  "entity": "${MUSIC_PLAYER}",
                  "name": "Music target"
                }
              ]
            },
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "entities",
                  "show_header_toggle": false,
                  "entities": [
                    {
                      "entity": "${ANNOUNCEMENT_TEXT}",
                      "name": "Announcement"
                    }
                  ]
                },
                {
                  "type": "grid",
                  "columns": 3,
                  "square": false,
                  "cards": [
                    {
                      "type": "button",
                      "name": "Announce",
                      "icon": "mdi:bullhorn",
                      "icon_height": "28px",
                      "show_state": false,
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "script.turn_on",
                        "target": {
                          "entity_id": "${ANNOUNCEMENT_SCRIPT}"
                        }
                      },
                      "hold_action": {
                        "action": "none"
                      }
                    },
                    {
                      "type": "button",
                      "name": "Assist",
                      "icon": "mdi:microphone-message",
                      "icon_height": "28px",
                      "show_state": false,
                      "tap_action": {
                        "action": "assist",
                        "pipeline_id": "last_used",
                        "start_listening": false
                      },
                      "hold_action": {
                        "action": "none"
                      }
                    },
                    {
                      "type": "button",
                      "name": "Main home",
                      "icon": "mdi:home",
                      "icon_height": "28px",
                      "show_state": false,
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "${MAIN_HOME_PATH}"
                      },
                      "hold_action": {
                        "action": "none"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Camera",
      "path": "camera",
      "icon": "mdi:camera",
      "type": "panel",
      "cards": [
        {
          "type": "grid",
          "columns": 2,
          "square": false,
          "cards": [
            {
              "type": "picture-entity",
              "entity": "${CAMERA}",
              "name": "Room camera",
              "camera_view": "live",
              "aspect_ratio": "16:9",
              "fit_mode": "contain",
              "show_name": false,
              "show_state": false,
              "tap_action": {
                "action": "more-info"
              },
              "hold_action": {
                "action": "none"
              }
            },
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "grid",
                  "columns": 2,
                  "square": false,
                  "cards": [
                    {
                      "type": "button",
                      "name": "Start camera",
                      "icon": "mdi:camera",
                      "icon_height": "28px",
                      "show_state": false,
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "script.turn_on",
                        "target": {
                          "entity_id": "${CAMERA_START_SCRIPT}"
                        }
                      },
                      "hold_action": {
                        "action": "none"
                      }
                    },
                    {
                      "type": "button",
                      "name": "Release camera",
                      "icon": "mdi:camera-off",
                      "icon_height": "28px",
                      "show_state": false,
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "script.turn_on",
                        "target": {
                          "entity_id": "${CAMERA_RELEASE_SCRIPT}"
                        }
                      },
                      "hold_action": {
                        "action": "none"
                      }
                    }
                  ]
                },
                {
                  "type": "entities",
                  "show_header_toggle": false,
                  "entities": [
                    {
                      "entity": "${CAMERA}",
                      "name": "Camera"
                    },
                    {
                      "entity": "${VOICE_SATELLITE}",
                      "name": "Voice connection"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Screen",
      "path": "screen",
      "icon": "mdi:monitor",
