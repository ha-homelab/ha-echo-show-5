                    },
                    {
                      "type": "button",
                      "name": "Home",
                      "icon": "mdi:home",
                      "icon_height": "28px",
                      "show_state": false,
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "${DASHBOARD_PATH}/home"
                      },
                      "hold_action": {
                        "action": "none"
                      }
                    }
                  ]
                },
                {
                  "type": "markdown",
                  "content": "Double tap to wake. Screen sleep and microphone privacy are separate."
                }
              ]
            }
          ]
        }
      ]
    },
