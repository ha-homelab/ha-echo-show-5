                    {
                      "type": "button",
                      "name": "Sleep screen",
                      "icon": "mdi:monitor-off",
                      "icon_height": "28px",
                      "show_state": false,
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "script.turn_on",
                        "target": {
                          "entity_id": "${SCREEN_SLEEP_SCRIPT}"
                        }
                      },
                      "hold_action": {
                        "action": "none"
                      }
                    },
                    {
                      "type": "button",
                      "name": "Show dashboard",
                      "icon": "mdi:home-assistant",
                      "icon_height": "28px",
                      "show_state": false,
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "script.turn_on",
                        "target": {
                          "entity_id": "${RETURN_HOME_SCRIPT}"
